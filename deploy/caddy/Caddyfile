{
	admin off
}

(pepeaudio_site) {
	encode zstd gzip

	@backend path /api/* /auth/* /health/*
	handle @backend {
		header Cache-Control "private, no-store"
		reverse_proxy api:3000 {
			health_uri /health/ready
			health_interval 10s
			health_timeout 2s
		}
	}

	handle {
		root * /srv
		route {
			try_files {path} /index.html

			@immutable_assets path /assets/*
			header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

			@app_shell path /index.html
			header @app_shell Cache-Control "no-cache"

			file_server
		}
	}

	header {
		-Server
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://cdn.discordapp.com; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

:8080 {
	import pepeaudio_site
}

{$PEPEAUDIO_DOMAIN:localhost} {
	import pepeaudio_site
}
