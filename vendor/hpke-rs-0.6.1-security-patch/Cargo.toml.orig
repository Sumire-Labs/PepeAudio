[package]
name = "hpke-rs"
version = "0.6.1"
authors = ["Franziskus Kiefer <franziskuskiefer@gmail.com>"]
edition = "2021"
license = "MPL-2.0"
documentation = "https://docs.rs/hpke-rs"
description = "HPKE Implementation"
readme = "Readme.md"
repository = "https://github.com/cryspen/hpke-rs"
exclude = ["/tests"]

[workspace]
resolver = "2"

[dependencies]
log = "0.4"
serde = { version = "1.0", features = ["derive"], optional = true }
tls_codec = { version = "0.4.2", features = ["derive"], optional = true }
subtle = { version = "2.6", default-features = false }
zeroize = { version = "1.5", features = ["zeroize_derive"] }
hpke-rs-crypto = { version = "0.6.1", default-features = false }
rand_core = { version = "0.9", default-features = false }
libcrux-sha3 = { version = "0.0.10" }
hpke-rs-rust-crypto = { version = "0.6.1", default-features = false, optional = true }

[features]
default = []
std = [
    "rand_core/std",
    "hpke-rs-crypto/std",
    "hpke-rs-rust-crypto?/std",
]
serialization = ["serde", "tls_codec", "tls_codec/serde", "std"]
hazmat = []
rustcrypto = ["dep:hpke-rs-rust-crypto"]
experimental = ["hpke-rs-rust-crypto?/experimental"]

hpke-test = ["std"]
hpke-test-prng = [
    "hpke-rs-rust-crypto?/deterministic-prng",
] # ⚠️ Enable testing PRNG - DO NOT USE

[dev-dependencies]
hpke-rs-crypto = { version = "0.6.1", features = ["std"] }
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"] }
lazy_static = "1.4"
rayon = "1.5"
hpke-rs = { path = ".", features = ["hpke-test", "hazmat"] }
hpke-rs-rust-crypto = { version = "0.6.1" }
rand = { version = "0.10" }
pretty_env_logger = "0.5"
criterion = { version = "0.8", features = ["html_reports"] }

[[bench]]
name = "bench"
harness = false

[[bench]]
name = "manual_benches"
harness = false
