# Rust build output
target/
.tmp-*-validation*/

# Front-end dependencies and build output
/web/node_modules/
/web/dist/
/web/.vite/
/web/playwright-report/
/web/test-results/

# Local configuration and secrets
.env
.env.*
!config/.env.example
/secrets/*
!/secrets/*.example
!/secrets/README.md
*.pem
*.key

# Runtime data
/storage/
/tmp/
*.log

# Imported media and HRIR presets are runtime data. Keep only the placeholder;
# third-party WAVs and metadata must not be committed with the MIT source.
/assets/hrir/*
!/assets/hrir/imported/
/assets/hrir/imported/*
!/assets/hrir/imported/.gitkeep
/assets/uploads/*
!/assets/uploads/.gitkeep

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
