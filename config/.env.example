# PepeAudio Compose configuration.
# Copy this file to the repository-root `.env`; never commit that file or any
# file below `secrets/`. The secret files themselves are created by the helper
# described in `docs/operations.md`.

# Images may be replaced with immutable registry tags in production.
PEPEAUDIO_MIGRATE_IMAGE=pepeaudio-migrate:local
PEPEAUDIO_API_IMAGE=pepeaudio-api:local
PEPEAUDIO_BOT_IMAGE=pepeaudio-bot:local
PEPEAUDIO_CADDY_IMAGE=pepeaudio-caddy:local

# Development dashboard. The base Compose file binds only to loopback and uses
# an explicit development identity; never expose this profile to a network.
PEPEAUDIO_DEV_HTTP_BIND=127.0.0.1:8080
PEPEAUDIO_PUBLIC_ORIGIN=http://localhost:8080
PEPEAUDIO_DEV_USER_ID=100000000000000001
PEPEAUDIO_DEV_GUILD_ID=100000000000000002
PEPEAUDIO_DEV_CSRF_TOKEN=replace-with-a-long-random-development-token

# Production HTTPS/OAuth. PEPEAUDIO_DOMAIN must match both DNS and the callback
# registered in the Discord Developer Portal. The callback path is
# https://<domain>/auth/callback.
PEPEAUDIO_DOMAIN=
PEPEAUDIO_DISCORD_CLIENT_ID=
PEPEAUDIO_HTTP_BIND=80
PEPEAUDIO_HTTPS_BIND=443
PEPEAUDIO_HTTPS_UDP_BIND=443
PEPEAUDIO_SESSION_ABSOLUTE_SECONDS=1800
PEPEAUDIO_SESSION_IDLE_SECONDS=1800
PEPEAUDIO_OAUTH_STATE_SECONDS=300

# Shard assignment. Every Bot process shares SHARD_TOTAL and owns one unique,
# half-open range [SHARD_START, SHARD_END_EXCLUSIVE). Same-shard rolling
# overlap is intentionally unsupported; stop the previous owner first.
PEPEAUDIO_SHARD_TOTAL=1
PEPEAUDIO_SHARD_START=0
# The bundled Compose profile is one Bot process and defaults its end to TOTAL.
# Partitioned deployments add PEPEAUDIO_SHARD_END_EXCLUSIVE in an override.
PEPEAUDIO_INSTANCE_ID=bot-0

# The API and every Bot process must use the same deployment keyspace. Leave
# this unset to use the profile-safe defaults (`pepeaudio-dev` for development,
# `pepeaudio-production` for production), or set one unique deployment value.
# PEPEAUDIO_VALKEY_KEYSPACE=

# Player limits.
PEPEAUDIO_IDLE_DISCONNECT_SECONDS=300
PEPEAUDIO_DEFAULT_VOLUME_PERCENT=75
PEPEAUDIO_MAX_QUEUE_ITEMS=100
PEPEAUDIO_MAX_TRACK_DURATION_SECONDS=21600
PEPEAUDIO_MAX_UPLOAD_BYTES=10485760
# Hard per-Bot-instance budget covering committed objects, staging files, and
# in-flight reservations. It must be at least PEPEAUDIO_MAX_UPLOAD_BYTES.
PEPEAUDIO_MAX_MANAGED_MEDIA_BYTES=10737418240

# Direct HTTPS audio and Discord attachments are always supported. The bot
# image also contains hash-pinned yt-dlp and Deno builds for YouTube and
# SoundCloud page/playlist URLs. Extractors stay off until the operator opts in
# after reviewing service terms and local law.
PEPEAUDIO_ENABLE_SITE_EXTRACTORS=false
PEPEAUDIO_MAX_SITE_MEDIA_BYTES=104857600
PEPEAUDIO_MAX_PLAYLIST_ITEMS=25

# Catalog overlays can match public metadata to a safe YouTube or SoundCloud
# result. `compose.catalog.public-metadata.yaml` needs no provider credentials,
# but is limited to Spotify tracks and Apple Music songs/albums. Credential
# overlays add Spotify albums and Apple Music playlists. Spotify playlists stay
# unsupported. Provider-specific public metadata also stays off unless the
# public-metadata overlay enables it explicitly. Secret values stay in the
# source files.
PEPEAUDIO_ENABLE_CROSS_SERVICE_MATCHING=false
PEPEAUDIO_ENABLE_SPOTIFY_PUBLIC_METADATA=false
PEPEAUDIO_ENABLE_APPLE_MUSIC_PUBLIC_METADATA=false
PEPEAUDIO_CATALOG_MAX_ITEMS=25
PEPEAUDIO_SPOTIFY_CLIENT_ID=
PEPEAUDIO_SPOTIFY_MARKET=JP
PEPEAUDIO_APPLE_MUSIC_TEAM_ID=
PEPEAUDIO_APPLE_MUSIC_KEY_ID=

# Logging filters.
PEPEAUDIO_API_LOG=info
PEPEAUDIO_BOT_LOG=info

# Host-side Docker secret paths. These files contain the actual credentials;
# Compose mounts only the secrets needed by each service.
PEPEAUDIO_POSTGRES_SUPERUSER_PASSWORD_SOURCE=./secrets/postgres_superuser_password.txt
PEPEAUDIO_POSTGRES_RUNTIME_PASSWORD_SOURCE=./secrets/postgres_runtime_password.txt
PEPEAUDIO_POSTGRES_MIGRATOR_PASSWORD_SOURCE=./secrets/postgres_migrator_password.txt
PEPEAUDIO_DATABASE_MIGRATOR_URL_SOURCE=./secrets/database_migrator_url.txt
PEPEAUDIO_DATABASE_RUNTIME_URL_SOURCE=./secrets/database_runtime_url.txt
PEPEAUDIO_VALKEY_PASSWORD_SOURCE=./secrets/valkey_password.txt
PEPEAUDIO_VALKEY_URL_SOURCE=./secrets/valkey_url.txt
PEPEAUDIO_DISCORD_TOKEN_SOURCE=./secrets/discord_token.txt
PEPEAUDIO_COMPONENT_SIGNING_KEY_SOURCE=./secrets/component_signing_key.txt
PEPEAUDIO_DISCORD_CLIENT_SECRET_SOURCE=./secrets/discord_client_secret.txt
PEPEAUDIO_SPOTIFY_CLIENT_SECRET_SOURCE=./secrets/spotify_client_secret.txt
PEPEAUDIO_APPLE_MUSIC_PRIVATE_KEY_SOURCE=./secrets/apple_music_private_key.p8
